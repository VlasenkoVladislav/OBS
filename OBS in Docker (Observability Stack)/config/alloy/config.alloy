/////////////// mimir metrics SYSTEM /////////////////////////////////////
prometheus.exporter.unix "system" {
  procfs_path = "/host/proc"
  sysfs_path = "/host/sys"
  rootfs_path = "/host/rootfs"
}

discovery.relabel "system_labels" {
  targets = prometheus.exporter.unix.system.targets

  rule {
    target_label = "job"
    replacement  = env("HOSTNAME")
  }

  rule {
    target_label = "host"
    replacement  = env("HOSTNAME")
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_IP")
  }
}

prometheus.scrape "raw_metrics" {
  targets = discovery.relabel.system_labels.output
  forward_to = [prometheus.relabel.fix_mountpoints.receiver]
  scrape_interval = "15s"
  scrape_timeout = "10s"
}

prometheus.relabel "fix_mountpoints" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    source_labels = ["mountpoint"]
    regex = "^/host/rootfs$"
    target_label = "mountpoint"
    replacement = "/"
  }

  rule {
    source_labels = ["mountpoint"]
    regex = "^/host/rootfs(/.*)"
    target_label = "mountpoint"
    replacement = "$1"
  }
}


prometheus.remote_write "mimir" {
  endpoint {
    url = "http://192.168.250.135:9009/api/v1/push"
  }
}
/////////////////////////////////////////////////////////////////

// /////////////LOKI logs //////////////////////////////////////

// ОБЩИЙ ФИЛЬТР СТАРЫХ ЛОГОВ
loki.process "filter_old_logs" {
  forward_to = [loki.write.loki.receiver]

  stage.drop {
    older_than = "168h"
  }
}

// Docker логи
discovery.docker "docker_discovery" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.docker_discovery.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
    replacement = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container_name"
    replacement = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "project_name"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label = "image"
  }

  rule {
    source_labels = ["__meta_docker_container_command"]
    target_label = "command"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "job"
    replacement = "docker"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "instance"
    replacement = "$1"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output

  labels     = {
    "job"      = "docker",
    "instance" = env("HOSTNAME"),
    "__path__" = "/var/lib/docker/containers/*/*.log",
  }

  forward_to = [loki.process.filter_old_logs.receiver]
}

// ОБЩАЯ ЗАПИСЬ
loki.write "loki" {
  endpoint {
    url = "http://192.168.250.135:3100/loki/api/v1/push"
  }
}
/////////////////////////////////////////////////////////////////